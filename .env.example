# Copy to backend/.env and fill in values. Never commit the real .env.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://catops:localdev@localhost:5434/catops"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong random secret (≥32 chars): openssl rand -hex 32
AUTH_SECRET="REPLACE-WITH-RANDOM-32+CHAR-STRING-DO-NOT-USE-DEV-DEFAULT"
AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4201"

# ─── Anthropic (optional — enables AI features) ──────────────────────────────
# ANTHROPIC_API_KEY="sk-ant-..."

# ─── AWS S3 (optional — enables file uploads) ────────────────────────────────
# S3_REGION="us-west-2"
# S3_ATTACHMENTS_BUCKET="cat-i-ops-attachments"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# ─── AWS SES (optional — enables outbound email) ─────────────────────────────
# SES_REGION="us-east-1"
# SES_FROM_EMAIL="support@cat-i.ai"

# ─── NetSuite (enables live KPI dashboard data via SuiteQL) ──────────────────
# Token-Based Auth (OAuth 1.0a). Create under Setup > Integration.
# Account ID / realm, e.g. 1234567 (prod) or 1234567_SB1 (sandbox)
# NETSUITE_ACCOUNT_ID=...
# NETSUITE_CONSUMER_KEY=...
# NETSUITE_CONSUMER_SECRET=...
# NETSUITE_TOKEN_ID=...
# NETSUITE_TOKEN_SECRET=...
# Optional — which field carries the production line (default: tl.class):
# NETSUITE_LINE_FIELD=tl.class
# Optional — paste verified SuiteQL to override the scaffolded queries
# (use {start} and {end} tokens for the date range):
# NETSUITE_SQL_BOTTLING=...
# NETSUITE_SQL_STRAW=...
# NETSUITE_SQL_WAREHOUSE=...
